{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "apps/admin/public/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
