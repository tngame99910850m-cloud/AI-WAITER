# AI Waiter API configuration. Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Comma-separated allowed CORS origins, or * for any (dev only)
CORS_ORIGINS=*

# Client API keys accepted from the mobile app (comma separated). Rotate in prod.
CLIENT_API_KEYS=dev-client-key

# Admin dashboard key (restaurant operators)
ADMIN_API_KEY=dev-admin-key

# POS adapter: memory (built-in reference) — add foodics/toast/square later
POS_ADAPTER=memory

# Persistence: memory (in-process demo seed) or postgres (load tenants from DB
# and write-through orders/service-requests/analytics/audit).
PERSISTENCE=memory
# Postgres connection string (server only). Use the Supabase DIRECT or SESSION
# connection (port 5432) so search_path is honored:
#   postgresql://postgres:[PASSWORD]@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=
# Schema the AI Waiter tables live in (isolated from other apps in a shared DB).
DB_SCHEMA=ai_waiter
DB_SSL=true
# When true, a failed DB connection aborts startup instead of falling back to seed.
DB_REQUIRED=false

# AI provider: rules (offline, deterministic) or anthropic (Claude API)
AI_PROVIDER=rules
# Required only when AI_PROVIDER=anthropic. NEVER ship this to the mobile app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info
