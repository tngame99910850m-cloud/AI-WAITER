# AI Waiter API configuration. Copy to .env for local development.
NODE_ENV=development
PORT=4000

# Comma-separated allowed CORS origins, or * for any (dev only)
CORS_ORIGINS=*

# Client API keys accepted from the mobile app (comma separated). Rotate in prod.
CLIENT_API_KEYS=dev-client-key

# Admin dashboard key (restaurant operators)
ADMIN_API_KEY=dev-admin-key

# POS adapter: memory (built-in reference) — add foodics/toast/square later
POS_ADAPTER=memory

# AI provider: rules (offline, deterministic) or anthropic (Claude API)
AI_PROVIDER=rules
# Required only when AI_PROVIDER=anthropic. NEVER ship this to the mobile app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Rate limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

LOG_LEVEL=info
